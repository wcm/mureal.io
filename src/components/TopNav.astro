---
const { currentPath = "/" } = Astro.props;
---

<header class="sticky top-0 z-20 bg-[#FFFDFB]/90 backdrop-blur">
	<nav class="mx-auto flex h-16 max-w-6xl items-center justify-center px-6">
		<a
			href="/"
			aria-label="Go to Mureal homepage"
			class:list={["inline-flex items-center rounded-md p-1 transition-opacity", currentPath === "/" ? "opacity-100" : "opacity-90 hover:opacity-100"]}
		>
			<img src="/mureal-logo.svg" alt="Mureal logo" class="h-8 w-auto" />
		</a>
	</nav>
</header>
