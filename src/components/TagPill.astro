---
interface Props {
	style: "ios" | "figma" | "user" | "likes";
	text: string;
	size?: "default" | "large";
}

const { style, text, size = "default" } = Astro.props;
const iconMap = {
	ios: "/icons/ios.svg",
	figma: "/icons/figma.svg",
	user: "/icons/user.svg",
	likes: "/icons/likes.svg",
};

const sizeClassMap = {
	default: "gap-1.5 rounded-md pl-1.5 pr-2.5 py-1 text-xs",
	large: "gap-2 rounded-lg pl-2 pr-3.5 py-1.5 text-sm",
};
---

<span class:list={["inline-flex items-center bg-black/4 text-black", sizeClassMap[size]]}>
	<img src={iconMap[style]} alt="" aria-hidden="true" class:list={["shrink-0", size === "large" ? "h-[18px] w-[18px]" : "h-4 w-4"]} />
	{text}
</span>
