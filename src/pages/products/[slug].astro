---
import { render } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import TopNav from "../../components/TopNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import TagPill from "../../components/TagPill.astro";
import BannerCarousel from "../../components/BannerCarousel.astro";
import ExploreMoreSidebar from "../../components/ExploreMoreSidebar.astro";
import { getSortedProducts } from "../../lib/products";

export async function getStaticPaths() {
	const products = await getSortedProducts();
	return products
		.filter((product) => product.data.type === "details_page")
		.map((entry) => ({
			params: { slug: entry.data.slug },
			props: { entry, allProducts: products },
		}));
}

const { entry, allProducts } = Astro.props;
const { Content } = await render(entry);

const pageTitle = entry.data.seoTitle ?? `${entry.data.title} | Mureal`;
const pageDescription = entry.data.seoDescription ?? entry.data.subtitle;
const canonicalPath = `/products/${entry.data.slug}/`;
const jsonLd = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	name: entry.data.title,
	description: pageDescription,
	applicationCategory: entry.data.category,
	operatingSystem: "Web",
	offers: {
		"@type": "Offer",
		price: "0",
		priceCurrency: "USD",
	},
	publisher: {
		"@type": "Organization",
		name: "Mureal",
		url: "https://mureal.io",
	},
	url: new URL(canonicalPath, Astro.site).toString(),
};
---

<MainLayout title={pageTitle} description={pageDescription} canonicalPath={canonicalPath} ogType="article" jsonLd={jsonLd}>
	<TopNav currentPath={Astro.url.pathname} />
	<main class="mx-auto px-6 pb-16">
		<div class="grid gap-8 lg:grid-cols-[auto_280px] justify-center">
			<article class="min-w-0 max-w-3xl">
				<nav aria-label="Breadcrumb" class="flex items-center text-base text-zinc-500">
					<a href="/" class="inline-flex items-center gap-1 transition hover:text-zinc-700 hover:bg-black/5 rounded-md p-1">
						<img src="/icons/home.svg" alt="Home" class="h-5 w-auto" />
					</a>
					<span class="mx-3">&gt;</span>
					<span>{entry.data.title}</span>
				</nav>

				<BannerCarousel banners={entry.data.banners} />

				<div class="mt-8 flex flex-col gap-6 sm:flex-row items-center">
					<div class="flex-1">
						<div class="text-3xl font-semibold tracking-tight text-center sm:text-left">{entry.data.title}</div>
						<div class="mt-6 flex justify-center sm:justify-start gap-2">
							{entry.data.tags.map((tag) => <TagPill style={tag.style} text={tag.text} size="large" />)}
						</div>
					</div>
					<a
						href={entry.data.tryNowUrl}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center justify-center rounded-full bg-black min-w-40 p-3 text-lg font-semibold text-white shadow-[inset_0_0_10px_6px_rgba(255,255,255,0.45),inset_0_0_4px_0px_rgba(255,255,255,0.8)] transition hover:bg-zinc-800"
					>
						Try Now
					</a>
				</div>

				<hr class="my-8 border-zinc-200" />

				<section class="product-content prose prose-zinc max-w-none prose-p:my-2 prose-a:text-sky-700 prose-h2:font-semibold">
					<Content />
				</section>

				<div class="m-10 flex justify-center">
					<a
						href={entry.data.tryNowUrl}
						target="_blank"
						rel="noreferrer noopener"
						class="inline-flex items-center justify-center rounded-full bg-black min-w-80 p-3 text-lg font-semibold text-white shadow-[inset_0_0_10px_6px_rgba(255,255,255,0.45),inset_0_0_4px_0px_rgba(255,255,255,0.8)] transition hover:bg-zinc-800"
					>
						Try Now
					</a>
				</div>
			</article>

			<div class="lg:sticky lg:top-28 lg:h-fit">
				<ExploreMoreSidebar currentSlug={entry.data.slug} products={allProducts} />
			</div>
		</div>
	</main>
	<SiteFooter />
</MainLayout>

<style>
	.product-content :global(h2) {
		border-top: 1px solid rgb(228 228 231);
		margin-top: 2rem;
		padding-top: 2rem;
	}

	.product-content :global(h2:first-of-type) {
		border-top: 0;
		margin-top: 0;
		padding-top: 2rem;
	}
</style>
