---
import { getEntry, render } from "astro:content";
import LegalPage from "../components/LegalPage.astro";

const entry = await getEntry("legal", "privacy");

if (!entry) {
	throw new Error("Missing legal content entry: privacy");
}

const { Content } = await render(entry);
---

<LegalPage
	title={entry.data.title}
	description="Privacy Policy for Mureal websites, apps, plugins, and digital services."
	canonicalPath="/privacy/"
	breadcrumbLabel={entry.data.title}
>
	<Content />
</LegalPage>
