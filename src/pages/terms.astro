---
import { getEntry, render } from "astro:content";
import LegalPage from "../components/LegalPage.astro";

const entry = await getEntry("legal", "terms");

if (!entry) {
	throw new Error("Missing legal content entry: terms");
}

const { Content } = await render(entry);
---

<LegalPage
	title={entry.data.title}
	description="Terms of Service for using Mureal websites, apps, plugins, and digital services."
	canonicalPath="/terms/"
	breadcrumbLabel={entry.data.title}
>
	<Content />
</LegalPage>
